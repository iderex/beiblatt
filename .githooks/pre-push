#!/bin/sh
# The gate, before a push. It runs the same command as everything else, so
# there is no third procedure to drift against the other two.
#
# It is not the enforcement. It is absent from a fresh clone, it is skippable
# with one flag, and whether any given clone installed it is a fact of that
# clone's local git configuration which nothing in this repository can read.
# The readme says exactly that where it tells somebody to install it.
#
# Shell, because git decides what a hook is and executes this file itself.
# That is a forced means and it is held to its minimum: find the interpreter
# the readme's install produced, and hand over to the gate.

set -eu

cd "$(git rev-parse --show-toplevel)"

for candidate in .venv/bin/python .venv/Scripts/python.exe python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
        exec "$candidate" -m gate
    fi
done

echo "pre-push: no python interpreter found. The readme's install makes one." >&2
exit 1
